#!ipxe
# End-to-end attestation against the running control plane.
#
# The control plane is reachable from the QEMU user-mode network at
# 10.0.2.2:8080.  The device is already registered (the registration
# window needs the public key, which this run exports).  This script
# follows the production chain: report the identity, fetch a nonce,
# quote it, then present the proof to /boot-vars.
echo === AK-E2E-BEGIN ===
dhcp || goto no-network
akgen || echo "AKGEN-FAILED"
akpub || goto report-done
chain --autofree http://10.0.2.2:8080/devices/report?mac=${mac}&ak_public=${ak-public}&ak_name=${ak-name}&ak_type=${ak-type}&sb=${sb} ||
:report-done
chain --autofree http://10.0.2.2:8080/devices/challenge?mac=${mac} && goto quoted || goto done
:quoted
quote ${nonce} || goto done
echo "nonce=${nonce}"
echo "quote=${quote}"
chain --autofree http://10.0.2.2:8080/boot-vars?mac=${mac}&nonce=${nonce}&quote=${quote}&quote_sig=${quote-sig} || goto done
echo "BOOT-VARS-OK"
:done
echo === AK-E2E-DONE ===
exit
:no-network
echo === AK-E2E-NO-NETWORK ===
exit
