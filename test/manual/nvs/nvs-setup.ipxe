#!ipxe
# NVS backend setup phase: store the TOFU settings (server-fingerprint
# and trust) into the EFI variable (explicit nvo block), then display them.
set nvo/server-fingerprint aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899
set nvo/trust 33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33:33
show nvo/server-fingerprint
show nvo/trust
echo NVS-SETUP-DONE
exit
