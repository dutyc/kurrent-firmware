+/** Report a TLS 1.3 key schedule mismatch */
+static void tls13_okx ( const char *name, const void *value,
+			const void *expected, size_t len ) {
+	int mismatch = ( memcmp ( value, expected, len ) != 0 );
+
+	if ( mismatch )
+		DBG ( "TLS13 %s mismatch\n", name );
+	ok ( ! mismatch );
