+/**
+ * Convert a hexadecimal digit to a nibble
+ *
+ * @v c			Character
+ * @ret nibble		Nibble value, or negative if invalid
+ */
+static int nvmetcp_hex_nibble ( char c ) {
+
+	if ( ( c >= '0' ) && ( c <= '9' ) )
+		return ( c - '0' );
+	if ( ( c >= 'a' ) && ( c <= 'f' ) )
+		return ( c - 'a' + 10 );
+	if ( ( c >= 'A' ) && ( c <= 'F' ) )
+		return ( c - 'A' + 10 );
+	return -1;
+}
