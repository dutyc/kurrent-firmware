#!/bin/sh
# initramfs-tools hook for the NBFT (NVMe Boot Firmware Table) consumer.
# Seed implementation; mirrors open-iscsi's hooks/iscsi packaging so it
# can be adopted by nvme-cli packaging (see initramfs-nbft/README).

PREREQ="udev"

prereqs()
{
	echo "$PREREQ"
}

case $1 in
# get pre-requisites
prereqs)
	prereqs
	exit 0
	;;
esac

if [ -r /etc/initramfs-tools/conf.d/nvme-cli ] ; then
	. /etc/initramfs-tools/conf.d/nvme-cli
fi

if [ x"$NO_NBFT_IN_INITRAMFS" = x"yes" ] ; then
	exit 0
fi

# Hooks for loading nbft bits into the initramfs
. /usr/share/initramfs-tools/hook-functions

# NBFT consumer core (framework-independent seed)
# NOTE: initramfs-tools 0.148 copy_file treats the copy_exec destdir as a
# directory only if it already exists under DESTDIR or the argument ends
# with '/'; otherwise the source is copied *as* the named file.  Trailing
# slashes keep the copy landing in the directory unconditionally.
if [ -x /usr/local/sbin/nbft-connect ] ; then
	copy_exec /usr/local/sbin/nbft-connect /usr/local/sbin/
else
	echo "nbft hook: nbft-connect not found, skipping" >&2
	exit 0
fi

# nvme-cli provides `nbft show` (parse) and `connect-all --nbft` (connect)
NVME_BIN="$(command -v nvme 2>/dev/null || echo /usr/sbin/nvme)"
if [ -x "$NVME_BIN" ] ; then
	copy_exec "$NVME_BIN" "${NVME_BIN%/*}/"
fi

# jq is required to parse `nvme nbft show -o json`
JQ_BIN="$(command -v jq 2>/dev/null || echo /usr/bin/jq)"
if [ -x "$JQ_BIN" ] ; then
	copy_exec "$JQ_BIN" "${JQ_BIN%/*}/"
fi

for x in nvme_fabrics nvme_tcp; do
	manual_add_modules ${x}
done

# TLS-PSK support for the kernel segment: `tls` provides kTLS, and
# `nvme-keyring` creates the global ".nvme` keyring that the psk key is
# injected into (it is pulled in by nvme-tcp, but add it explicitly so the
# TLS path does not depend on module dependency resolution).
for x in tls nvme-keyring; do
	manual_add_modules ${x}
done

# TLS handshake upcall daemon: the kernel performs the TLS 1.3 handshake via
# a generic-netlink upcall to tlshd (ktls-utils), so it must be present and
# running in the initramfs.
TLSHD_BIN="$(command -v tlshd 2>/dev/null || echo /usr/sbin/tlshd)"
if [ -x "$TLSHD_BIN" ] ; then
	copy_exec "$TLSHD_BIN" "${TLSHD_BIN%/*}/"
	# tlshd exits immediately when its config file is absent, which leaves
	# the kernel handshake upcall with no netlink listener (nvme connect
	# then fails with "failed to start TLS: -3").  The packaged default is
	# all-defaults, so ship the host file if present and otherwise create an
	# empty one -- the file must merely exist.
	mkdir -p "${DESTDIR}/etc/tlshd"
	if [ -r /etc/tlshd/config ] ; then
		cp -a /etc/tlshd/config "${DESTDIR}/etc/tlshd/config"
	else
		: > "${DESTDIR}/etc/tlshd/config"
	fi
else
	echo "nbft hook: tlshd not found, TLS sessions will fail" >&2
fi

# keyctl injects the NBCT-carried PSK into the .nvme keyring before connect.
KEYCTL_BIN="$(command -v keyctl 2>/dev/null || echo /usr/bin/keyctl)"
if [ -x "$KEYCTL_BIN" ] ; then
	copy_exec "$KEYCTL_BIN" "${KEYCTL_BIN%/*}/"
else
	echo "nbft hook: keyctl not found, TLS PSK injection will fail" >&2
fi
